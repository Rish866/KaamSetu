{
  "expo": {
    "name": "KaamSetu",
    "slug": "kaamsetu",
    "version": "1.3.0",
    "orientation": "portrait",
    "scheme": "kaamsetu",
    "icon": "./assets/kaamsetu-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rish866.kaamsetu",
      "buildNumber": "4"
    },
    "android": {
      "package": "com.rish866.kaamsetu",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#11152D",
        "foregroundImage": "./assets/kaamsetu-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/kaamsetu-icon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/kaamsetu-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#11152D"
        }
      ]
    ]
  }
}
